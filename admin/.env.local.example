# ============================================================================
# Disiplan Admin Panel — Environment Variables
# Bu dosyayı .env.local olarak kopyala ve gerçek değerleri doldur
# .env.local zaten .gitignore'da, commit edilmez
# ============================================================================

# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ⚠️ Service role key — sadece sunucu tarafında kullanılır, NEXT_PUBLIC_ prefix YOK
# Bu key veritabanındaki TÜM RLS'i bypass eder, ASLA client'a sızmasın
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# PostHog (https://posthog.com → Project Settings)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Admin app URL (cookie domain için)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ============================================================================
# E2E Test Credentials (Playwright tests/global-setup.ts kullanır)
# Sadece lokal koşum için — CI'da GitHub Actions secret olarak yönetilir
# ============================================================================
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=admin_password
# Web app testleri farklı kullanıcı isteniyorsa (boş bırakılırsa admin ile aynı)
TEST_WEB_EMAIL=user@example.com
TEST_WEB_PASSWORD=user_password
